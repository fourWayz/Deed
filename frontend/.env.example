NEXT_PUBLIC_LENS=0xDd628bBb4663549E0Af7815E93D14002D1f9Dde1
# block the deployment was created at (deployBlock), the chain scan behind the activity page starts here
NEXT_PUBLIC_START_BLOCK=16737425
# name the indexer gives this deployment, every other version it reports is shown as an earlier deployment
NEXT_PUBLIC_DEPLOYMENT_VERSION=v3
# your own project id from cloud.walletconnect.com, WalletConnect is rejected without a real one
NEXT_PUBLIC_WC_PROJECT_ID=
# base url of the indexer api, all stats come from it. Empty, or unreachable, and the app counts this deployment's events from the chain itself.
NEXT_PUBLIC_INDEXER_URL=https://deed-lovat.vercel.app
# the team's test wallets (the two test users and the deployer/treasury), public addresses. Stats are labelled
# "testnet activity from the team's test wallets" until a wallet that is not listed here appears in the activity.
NEXT_PUBLIC_TEAM_WALLETS=0x522bc0c3919ff823173ca4145feece905f772ffe,0xef05acadf5d3ff7e8e5f0be2515f2be351e225a6,0x4989CC7150a869D6b07540B54B96fD02c5e0537c
# optional: mp4 file or Vimeo player url shown on the landing page
NEXT_PUBLIC_DEMO_VIDEO=
