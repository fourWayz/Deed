# Supabase: Project settings > Database > Connection string (use the pooler URI, session mode)
DATABASE_URL=
MEZO_TESTNET_RPC=https://rpc.test.mezo.org
PORT=8787
# blocks per eth_getLogs call; Mezo rejects ranges over 10000, so this is capped at 10000
BATCH_BLOCKS=9000
POLL_MS=4000
RATE_LIMIT_PER_MIN=120
